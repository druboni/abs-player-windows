<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AbsPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AbsPlayer.App"
    Title="ABS Player">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnTogglePlay" />
            <KeyboardAccelerator Modifiers="Control" Key="Left" Invoked="OnSkipBack" />
            <KeyboardAccelerator Modifiers="Control" Key="Right" Invoked="OnSkipForward" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Left" Invoked="OnPreviousChapter" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Right" Invoked="OnNextChapter" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnCycleSpeed" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBack" />
        </Grid.KeyboardAccelerators>

        <!-- Top bar -->
        <Grid x:Name="TopBar" Padding="12,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" IsEnabled="False" ToolTipService.ToolTip="Back (Alt+Left)"
                    Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F6;" Foreground="{StaticResource AccentText}" FontSize="18" />
                <TextBlock Text="ABS Player" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" Width="320" PlaceholderText="Titles, authors, series"
                            QueryIcon="Find" TextChanged="OnSearchTextChanged" VerticalAlignment="Center" />
            <Button x:Name="RequestButton" Grid.Column="4" Click="OnRequestsClick" ToolTipService.ToolTip="Request a book (Audiobook Requester)" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Request" />
                </StackPanel>
            </Button>
            <ComboBox x:Name="LibraryPicker" Grid.Column="5" MinWidth="160" VerticalAlignment="Center"
                      DisplayMemberPath="Name" SelectionChanged="OnLibraryPicked" Visibility="Collapsed"
                      ToolTipService.ToolTip="Library" />
            <Button Grid.Column="6" Click="OnSettingsClick" ToolTipService.ToolTip="Settings"
                    Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Shown when a newer release is on GitHub. -->
        <InfoBar x:Name="UpdateBar" Grid.Row="1" Margin="12,0,12,8" Severity="Informational" IsOpen="False" Title="Update available">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateButton" Content="Download and install" Click="OnInstallUpdate" Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <HyperlinkButton x:Name="ReleaseNotesLink" Content="Release notes" Padding="0" />
                    <ProgressBar x:Name="UpdateProgress" Width="200" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <Frame x:Name="ContentFrame" Grid.Row="2" Navigated="OnNavigated" />

        <local:NowPlayingBar x:Name="NowPlaying" Grid.Row="3" Visibility="Collapsed" />
    </Grid>
</Window>
