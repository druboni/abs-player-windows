<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AbsPlayer.App.Pages.BookDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AbsPlayer.App.Pages">
    <ScrollViewer>
        <StackPanel MaxWidth="700" Spacing="10" Padding="24" HorizontalAlignment="Stretch">
            <Grid Width="300" Height="300" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                <FontIcon Glyph="&#xE7F6;" FontSize="64" Opacity="0.25" />
                <Image x:Name="Cover" Stretch="UniformToFill" />
            </Grid>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
            <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="SeriesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="DurationText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="ResumeText" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

            <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource AccentButtonStyle}" Width="260" Height="40" HorizontalAlignment="Center" Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Name="PlayText" Text="Play" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />

            <Expander x:Name="ChaptersExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Chapters" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ChapterCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander.Header>
                <ListView x:Name="ChapterList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnChapterClick" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChapterRow">
                            <Grid ColumnSpacing="10" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Visibility="{x:Bind NumberVisibility}" />
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{StaticResource AccentText}" Visibility="{x:Bind CurrentVisibility}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Foreground="{x:Bind TitleBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Length}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>

            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,12,0,0" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
