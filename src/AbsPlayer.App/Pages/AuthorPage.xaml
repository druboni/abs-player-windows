<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AbsPlayer.App.Pages.AuthorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,8,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <GridView x:Name="Books" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnBookClick"
                  ItemTemplate="{StaticResource BookTile}" />
        <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="True" VerticalAlignment="Top" Margin="0,40" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No books found" Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,40" Visibility="Collapsed" />
    </Grid>
</Page>
