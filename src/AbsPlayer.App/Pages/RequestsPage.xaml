<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AbsPlayer.App.Pages.RequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AbsPlayer.App.Pages"
    NavigationCacheMode="Required">
    <Page.Resources>
        <!-- An Audible search result. -->
        <DataTemplate x:Key="ResultRow" x:DataType="local:ResultRow">
            <Grid ColumnSpacing="14" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind SeriesLine}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource AccentText}" Visibility="{x:Bind SeriesVisibility}" />
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind People}" Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" MinWidth="130">
                    <Button Content="Request" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Visibility="{x:Bind RequestVisibility, Mode=OneWay}" Click="OnRequestClick" Tag="{x:Bind}" />
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Visibility="{x:Bind StatusVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One of my requests, or one waiting for an admin. -->
        <DataTemplate x:Key="RequestRow" x:DataType="local:RequestRow">
            <Grid ColumnSpacing="14" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="64" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind Byline}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{x:Bind StatusText}" Foreground="{x:Bind StatusBrush}" TextWrapping="Wrap" />
                    <ProgressBar Value="{x:Bind Percent}" Maximum="100" Width="220" HorizontalAlignment="Left" Visibility="{x:Bind ProgressVisibility}" />
                    <TextBlock Text="{x:Bind Message}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="{x:Bind MessageVisibility}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OnListenClick" Tag="{x:Bind}" Visibility="{x:Bind ListenVisibility}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Listen" />
                        </StackPanel>
                    </Button>
                    <Button Content="Approve" Click="OnApproveClick" Tag="{x:Bind}" Visibility="{x:Bind AdminVisibility}" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Decline" Click="OnDeclineClick" Tag="{x:Bind}" Visibility="{x:Bind AdminVisibility}" />
                    <Button Content="Cancel" Click="OnCancelClick" Tag="{x:Bind}" Visibility="{x:Bind CancelVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Request a Book" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" FontSize="13" />
            </StackPanel>
            <SelectorBar x:Name="Tabs" HorizontalAlignment="Right" VerticalAlignment="Bottom" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="SearchTab" Text="Search" IsSelected="True" />
                <SelectorBarItem x:Name="MineTab" Text="My Requests" />
                <SelectorBarItem x:Name="ApprovalsTab" Text="Approvals" Visibility="Collapsed" />
            </SelectorBar>
        </Grid>

        <!-- Not set up yet -->
        <StackPanel x:Name="NotConnected" Grid.Row="1" Grid.RowSpan="2" Spacing="12" Margin="0,40" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
            <FontIcon Glyph="&#xE710;" FontSize="40" Foreground="{StaticResource AccentText}" />
            <TextBlock Text="Connect Audiobook Requester" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="NotConnectedText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Secondary}" FontSize="14"
                       Text="Ask for books that aren't in your library yet. Add your Audiobook Requester address in Settings." />
            <Button Content="Open Settings" HorizontalAlignment="Center" Click="OnOpenSettings" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- Search -->
        <Grid x:Name="SearchPanel" Grid.Row="1" Grid.RowSpan="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="QueryBox" PlaceholderText="Search Audible by title, author or narrator" QueryIcon="Find" MaxWidth="600" HorizontalAlignment="Left" Width="600"
                            QuerySubmitted="OnQuerySubmitted" />
            <ListView x:Name="Results" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource ResultRow}" MaxWidth="900" HorizontalAlignment="Left" />
            <ProgressRing x:Name="Searching" Grid.Row="1" IsActive="False" VerticalAlignment="Top" Margin="0,40" />
            <TextBlock x:Name="SearchEmpty" Grid.Row="1" Style="{StaticResource Secondary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40" TextWrapping="Wrap" TextAlignment="Center" />
        </Grid>

        <!-- My requests / approvals -->
        <Grid x:Name="ListPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <ListView x:Name="RequestList" SelectionMode="None" ItemTemplate="{StaticResource RequestRow}" MaxWidth="900" HorizontalAlignment="Left" />
            <ProgressRing x:Name="ListLoading" IsActive="False" VerticalAlignment="Top" Margin="0,40" />
            <TextBlock x:Name="ListEmpty" Style="{StaticResource Secondary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40" TextWrapping="Wrap" TextAlignment="Center" />
        </Grid>
    </Grid>
</Page>
