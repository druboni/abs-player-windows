<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AbsPlayer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AbsPlayer.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Orange accent, like the Apple apps. -->
            <Color x:Key="SystemAccentColor">#FFF0861A</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF59A3D</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF8AE62</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFBC48A</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD87412</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB8600C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF934B07</Color>
            <SolidColorBrush x:Key="AccentText" Color="{StaticResource SystemAccentColor}" />

            <local:CoverConverter x:Key="Cover" />
            <local:SmallCoverConverter x:Key="SmallCover" />

            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="BookTile">
                <StackPanel Width="160" Height="236" Spacing="2" Padding="0,0,0,8" VerticalAlignment="Top">
                    <Grid Width="160" Height="160" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE7F6;" FontSize="40" Opacity="0.25" />
                        <Image Source="{Binding Cover, Converter={StaticResource Cover}}" Stretch="UniformToFill" />
                        <ProgressBar VerticalAlignment="Bottom" Value="{Binding Progress}" Visibility="{Binding ProgressVisibility}" MinHeight="4" CornerRadius="0" />
                        <Border Visibility="{Binding FinishedVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                CornerRadius="11" Width="22" Height="22" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Author}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="SeriesTile">
                <StackPanel Width="160" Height="252" Spacing="2" Padding="0,0,0,8" VerticalAlignment="Top">
                    <!-- Up to three covers stacked, so a series reads differently from a single book. -->
                    <Grid Width="160" Height="176">
                        <Border Width="140" Height="140" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,0,0" Opacity="0.6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{Binding Cover3, Converter={StaticResource Cover}}" Stretch="UniformToFill" />
                        </Border>
                        <Border Width="150" Height="150" CornerRadius="8" VerticalAlignment="Top" Margin="0,8,0,0" Opacity="0.8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{Binding Cover2, Converter={StaticResource Cover}}" Stretch="UniformToFill" />
                        </Border>
                        <Border Width="160" Height="160" CornerRadius="8" VerticalAlignment="Bottom"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE8F1;" FontSize="40" Opacity="0.25" />
                                <Image Source="{Binding Cover1, Converter={StaticResource Cover}}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </DataTemplate>

            <local:TileTemplateSelector x:Key="TileSelector" BookTemplate="{StaticResource BookTile}" SeriesTemplate="{StaticResource SeriesTile}" />

            <!-- A book as a list row (series and author lists). -->
            <DataTemplate x:Key="BookRow">
                <Grid ColumnSpacing="12" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Image Source="{Binding Cover, Converter={StaticResource SmallCover}}" Stretch="UniformToFill" />
                        <ProgressBar VerticalAlignment="Bottom" Value="{Binding Progress}" Visibility="{Binding ProgressVisibility}" MinHeight="3" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding SeriesLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource AccentText}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{Binding Author}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
